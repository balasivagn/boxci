      "variant": "security"
    },
    {
      "id": "resume",
      "from": "wake",
      "to": "pool",
      "label": "trusted: wake + check",
      "variant": "security"
    },
    {
      "id": "route",
      "from": "wake",
      "to": "build",
      "label": "emit runner labels",
      "variant": "emphasis"
    },
    {
      "id": "schedule",
      "from": "build",
      "to": "pool",
      "label": "all services ready",
      "variant": "emphasis"
    },
    {
      "id": "fallback-route",
      "from": "build",
      "to": "fallback",
      "label": "fork / wake failure",
      "variant": "dashed"
    }
