  "cards": [
    {
      "dot": "cyan",
      "title": "Setup stays local",
      "items": [
        "Official InstaBox + GitHub sign-ins; account, VM and dedicated-label checks before changes.",
        "CLI installs runners and CI settings; workflow changes stay local for review, commit and push."
      ]
    },
    {
      "dot": "emerald",
      "title": "CI runs independently",
      "items": [
        "Hosted wake uses Python standard-library HTTP calls; it does not need this CLI or a running dashboard.",
        "Every reviewed VM must be ready; GitHub then assigns work by shared runner labels."
      ]
    },
    {
      "dot": "amber",
      "title": "Boundaries that matter",
      "items": [
        "Status and dashboard read APIs without guest execution or VM resume.",
        "Service readiness does not prove GitHub connectivity; fallback cannot rescue an already queued job."
      ]
    }
  ]
}
