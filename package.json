{
  "name": "@balasivagn/boxci",
  "version": "0.4.1",
  "description": "BoxCI: GitHub Actions on InstaBox. One setup, paused runners that wake for CI, optional local dashboard.",
  "type": "module",
  "bin": {
    "boxci": "bin/boxci.js"
  },
  "engines": {
    "node": "^22.23.4 || >=24.22.1"
  },
  "scripts": {
    "test": "node --test",
    "check": "prettier --check bin src web tests docs README.md package.json .github",
    "start": "node bin/boxci.js dashboard",
    "pack:local": "npm pack --pack-destination dist",
    "format": "prettier --write bin src web tests docs README.md package.json .github"
  },
  "files": [
    "bin",
    "src",
    "web",
    "ci/wake.py",
    "vendor",
    "LICENSE",
    "NOTICE",
    "README.md",
    "docs/ARCHITECTURE.md",
    "docs/architecture",
    "docs/CONFIGURATION.md",
    "docs/DEVELOPER_EXPERIENCE.md",
    "docs/DESIGN.md",
    "docs/OPERATIONS.md",
    "docs/VALIDATION.md",
    "docs/RELEASING.md",
    "skills",
    "SECURITY.md"
  ],
  "dependencies": {
    "@insforge/instabox-sdk": "0.5.3",
    "instabox": "0.6.3"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/balasivagn/boxci.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "prettier": "3.9.10"
  }
}
